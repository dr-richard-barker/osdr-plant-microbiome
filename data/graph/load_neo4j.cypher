// Neo4j loader for the OSDR plant-microbiome knowledge graph
// Run: cat load_neo4j.cypher | cypher-shell

MERGE (:Study {id: "OSD-766", label: "OSD-766", n_samples: 144, title: "The microbial communities of a tomato crop grown in Veggie under different lighting regimes on the International Space Station", url: "https://osdr.nasa.gov/bio/repo/data/studies/OSD-766"});
MERGE (:Organism {id: "Organism:Solanum lycopersicum", label: "Solanum lycopersicum"});
MERGE (:Hardware {id: "Hardware:Veggie", label: "Veggie"});
MERGE (:Assay {id: "Assay:16S rRNA amplicon", label: "16S rRNA amplicon"});
MERGE (:Region {id: "Region:V3-V4", label: "V3-V4"});
MERGE (:Tissue {id: "Tissue:fruit", label: "fruit"});
MERGE (:Tissue {id: "Tissue:substrate", label: "substrate"});
MERGE (:Tissue {id: "Tissue:swab", label: "swab"});
MERGE (:Tissue {id: "Tissue:root", label: "root"});
MERGE (:Tissue {id: "Tissue:leaf", label: "leaf"});
MERGE (:Tissue {id: "Tissue:wick", label: "wick"});
MERGE (:Tissue {id: "Tissue:water", label: "water"});
MERGE (:Factor {id: "Factor:Spaceflight", label: "Spaceflight"});
MERGE (:Factor {id: "Factor:Tissue type", label: "Tissue type"});
MERGE (:Factor {id: "Factor:Light regime (red-rich vs blue-rich)", label: "Light regime (red-rich vs blue-rich)"});
MERGE (:Study {id: "OSD-412", label: "OSD-412", n_samples: 47, title: "Spatial characterization of microbial communities on multi-species leafy greens grown in Veggie VEG-03D on the ISS", url: "https://osdr.nasa.gov/bio/repo/data/studies/OSD-412"});
MERGE (:Organism {id: "Organism:mixed community", label: "mixed community"});
MERGE (:Region {id: "Region:V4", label: "V4"});
MERGE (:Factor {id: "Factor:Sample type", label: "Sample type"});
MERGE (:Factor {id: "Factor:Plant position", label: "Plant position"});
MERGE (:Study {id: "OSD-413", label: "OSD-413", n_samples: 48, title: "Spatial characterization of microbial communities on multi-species leafy greens grown in Veggie VEG-03E on the ISS", url: "https://osdr.nasa.gov/bio/repo/data/studies/OSD-413"});
MERGE (:Study {id: "OSD-414", label: "OSD-414", n_samples: 48, title: "Spatial characterization of microbial communities on multi-species leafy greens grown in Veggie VEG-03F on the ISS", url: "https://osdr.nasa.gov/bio/repo/data/studies/OSD-414"});
MERGE (:Study {id: "OSD-772", label: "OSD-772", n_samples: 96, title: "Evaluating microbial community profiles of Chile peppers grown on the International Space Station", url: "https://osdr.nasa.gov/bio/repo/data/studies/OSD-772"});
MERGE (:Organism {id: "Organism:Capsicum annuum", label: "Capsicum annuum"});
MERGE (:Hardware {id: "Hardware:Advanced Plant Habitat", label: "Advanced Plant Habitat"});
MERGE (:Factor {id: "Factor:Hardware component", label: "Hardware component"});
MERGE (:Factor {id: "Factor:Science carrier quadrant", label: "Science carrier quadrant"});
MERGE (:Study {id: "OSD-773", label: "OSD-773", n_samples: 60, title: "Amplicon characterization of microbial communities from multi-species plant growth on the ISS", url: "https://osdr.nasa.gov/bio/repo/data/studies/OSD-773"});
MERGE (:Hardware {id: "Hardware:Veggie/XROOTS", label: "Veggie/XROOTS"});
MERGE (:Assay {id: "Assay:ITS amplicon", label: "ITS amplicon"});
MERGE (:Region {id: "Region:ITS1;V4", label: "ITS1;V4"});
MERGE (:Factor {id: "Factor:Harvest timepoint", label: "Harvest timepoint"});
MERGE (:Factor {id: "Factor:Cultivar", label: "Cultivar"});
MATCH (a {id: "OSD-766"}),(b {id: "Organism:Solanum lycopersicum"}) MERGE (a)-[:STUDIES_ORGANISM]->(b);
MATCH (a {id: "OSD-766"}),(b {id: "Hardware:Veggie"}) MERGE (a)-[:USES_HARDWARE]->(b);
MATCH (a {id: "OSD-766"}),(b {id: "Assay:16S rRNA amplicon"}) MERGE (a)-[:MEASURED_BY]->(b);
MATCH (a {id: "OSD-766"}),(b {id: "Region:V3-V4"}) MERGE (a)-[:TARGETS_REGION]->(b);
